# Copy to .env for local development. Never commit a real .env.
DATABASE_URL=postgresql://caparium:CHANGE_ME@127.0.0.1:5432/caparium
# "true" only behind HTTPS
COOKIE_SECURE=false
# docker compose (in Coolify these are generated: SERVICE_PASSWORD_*)
SERVICE_PASSWORD_POSTGRES=CHANGE_ME
# the server role caparium_app (at least 16 characters, URL-safe)
SERVICE_PASSWORD_APP=CHANGE_ME
# set only in a test environment: the password of the synthetic test users; empty = no seed
SERVICE_PASSWORD_SEED=
# "on" only in a test environment: runs the test seed with the password above (the password alone does not)
CAPARIUM_TEST_SEED=
# where the app is published (stage: the tailnet address)
APP_BIND=127.0.0.1
APP_PORT=3000
# public test site only: the basic-auth gate before every path (empty = off)
BASIC_AUTH_USER=
SERVICE_PASSWORD_BASICAUTH=
